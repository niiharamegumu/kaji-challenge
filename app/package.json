{
  "name": "kaji-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -b && tsc -p tsconfig.infra.json",
    "preview": "vp preview",
    "lint": "vp lint --ignore-path .prettierignore",
    "lint:compiler": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:all": "bun run format:check && bun run lint && bun run lint:compiler && bun run architecture:check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.infra.json",
    "test": "vp test",
    "pwa:assets": "pwa-assets-generator public/app.png -p minimal --override",
    "deploy": "alchemy deploy",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:server": "vp test --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "diagnose:react": "react-doctor .",
    "test:local": "node scripts/verify-local.mjs",
    "infra:plan": "alchemy plan",
    "infra:bootstrap": "alchemy provider cloudflare bootstrap",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:studio": "open http://localhost:5174/cdn-cgi/local/explorer",
    "types:bindings": "wrangler types --env-interface Env --include-runtime false"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.53",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "jotai": "^2.20.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "web-push": "3.6.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260914.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/parser": "^8.62.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "alchemy": "2.0.0-beta.77",
    "babel-plugin-react-compiler": "^1.0.0",
    "effect": "4.0.0-rc.112",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react-doctor": "0.9.14",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1",
    "wrangler": "^4.104.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@hono/node-server": "1.19.15",
    "esbuild": "0.28.1",
    "hono": "4.13.5",
    "js-yaml": "4.3.2",
    "lodash": "^4.18.1",
    "serialize-javascript": "^7.0.5",
    "sharp": "^0.35.2",
    "valibot": "1.4.2"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "bun@1.4.2"
}
