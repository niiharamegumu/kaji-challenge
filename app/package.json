{
  "name": "kaji-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "security:runtime": "node scripts/check-runtime-security.mjs && bun scripts/check-runtime-security.mjs",
    "security": "bun run security:runtime && bun audit --audit-level moderate",
    "preinstall": "bun run security:runtime",
    "dev": "bun run security:runtime && vp dev",
    "build": "bun run security:runtime && node scripts/check-oauth-provider-patch.mjs && vp build && tsc -b && tsc -p tsconfig.infra.json",
    "preview": "bun run security:runtime && vp preview",
    "lint": "vp lint --ignore-path .prettierignore",
    "lint:compiler": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:all": "bun run format:check && bun run lint && bun run lint:compiler && bun run architecture:check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.infra.json",
    "test": "vp test",
    "pwa:assets": "pwa-assets-generator public/app.png -p minimal --override",
    "deploy": "bun run security:runtime && alchemy deploy",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:server": "vp test --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "diagnose:react": "react-doctor .",
    "test:local": "bun run security:runtime && node scripts/verify-local.mjs",
    "test:ci": "bun run security:runtime && node scripts/verify-local.mjs --ci",
    "infra:plan": "bun run security:runtime && alchemy plan",
    "infra:bootstrap": "bun run security:runtime && alchemy provider cloudflare bootstrap",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:studio": "open http://localhost:5174/cdn-cgi/local/explorer",
    "types:bindings": "wrangler types --env-interface Env --include-runtime false && node scripts/generate-mcp-bindings.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "^7.1.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "agents": "0.28.1",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "jotai": "^3.0.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "temporal-polyfill": "^1.0.6",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/parser": "^8.71.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.83",
    "babel-plugin-react-compiler": "^1.0.0",
    "effect": "4.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react-doctor": "0.9.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.5",
    "@hono/node-server": "2.1.3",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "js-yaml": "4.3.2",
    "lodash": "^4.18.1",
    "miniflare": {
      "undici": "7.30.1"
    },
    "serialize-javascript": "^7.1.3",
    "seroval": "1.6.11",
    "sharp": "^0.35.5",
    "valibot": "1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.22.1 <25"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@cloudflare/workers-oauth-provider@1.2.3": "patches/@cloudflare%2Fworkers-oauth-provider@1.2.3.patch"
  }
}
