# Optional manual deploy values. Copy only if you choose to manage a local env file.
# CD reads GitHub Environment production Secrets/Variables instead of this file.
# APP_RELEASE is set to the commit SHA by CD. Never commit actual credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
APP_ORIGIN=https://kaji.example.com
APP_RELEASE=initial-d1
JOBS_ENABLED=false
MAINTENANCE_MODE=false
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SIGNUP_ALLOWED_EMAILS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
